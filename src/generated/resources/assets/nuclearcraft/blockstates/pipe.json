{
  "multipart": [
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/core"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_y",
        "x": 270
      },
      "when": {
        "up": "true"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_y",
        "x": 90
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_z"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_z",
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_x",
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "nuclearcraft:block/pipe/arm_x",
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}